---
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";

const expertise = [
	{
		title: "Autonomous Robotics & AI Control",
		body: "Designing robust hardware-software robotic platforms powered by advanced machine perception, spatial intelligence, and real-time motion planning.",
	},
	{
		title: "Gemma-Powered On-Robot Intelligence",
		body: "Fine-tuning domain-specific Small Language Models (SLMs) built on Google's open Gemma architecture for low-latency, localized decision-making on edge devices.",
	},
	{
		title: "Trustless Multi-Agent Coordination",
		body: "Leveraging decentralized blockchain architecture to enable secure, peer-to-peer communication, data integrity, and autonomous task consensus across multi-robot swarms.",
	},
	{
		title: "Enterprise Autonomous Operations",
		body: "Deploying scalable, self-healing robotic workflows engineered for complex, dynamic environments with full operational sovereignty.",
	},
];
---

<PageLayout meta={{ title: "Home" }}>
	<div data-pagefind-body data-pagefind-meta="title:Home">
		<section>
			<h1 class="title mb-2">Hello, AI!</h1>
			<p class="text-muted mb-6">
				Pioneering the next generation of autonomous &amp; intelligent robotic systems.
			</p>
			<p class="mb-4">
				Strawhat is a premier research and development firm engineering the next generation of
				autonomous and intelligent robotic systems. By combining state-of-the-art AI, fine-tuned
				Gemma-based models, and decentralized blockchain frameworks, we build physical and digital
				systems capable of independent reasoning, adaptiveness, and trustless multi-agent
				coordination.
			</p>
		</section>

		<section class="mt-16">
			<h2 class="title text-accent mb-6 text-xl">Core Areas of Expertise</h2>
			<ul class="space-y-4" role="list">
				{
					expertise.map(({ title, body }) => (
						<li>
							<h3 class="text-accent-2 font-semibold">{title}</h3>
							<p>{body}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mt-16">
			<h2 class="title text-accent mb-6 text-xl">Why Strawhat?</h2>
			<p>
				We unify physical automation with cutting-edge intelligence and decentralized trust. By
				combining parameter-efficient Gemma models for edge inference with blockchain protocol
				verification, Strawhat delivers multi-agent robotic systems that cooperate seamlessly,
				maintain complete data sovereignty, and operate reliably in critical environments.
			</p>
		</section>

		<section class="mt-16">
			<h2 class="title text-accent mb-6 text-xl">Contact Us</h2>
			<p class="mb-4">
				Ready to build the future of AI robotics? Connect with our team to discuss research
				partnerships or enterprise integrations at{" "}
				<a class="cactus-link" href="mailto:obulapathinchalla@strawhat.xyz"
					>obulapathinchalla@strawhat.xyz</a
				>.
			</p>
			<SocialList />
		</section>
	</div>
</PageLayout>
